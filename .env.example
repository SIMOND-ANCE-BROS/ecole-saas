# Application : rôle soumis à la Row Level Security
DATABASE_URL=postgres://app_user:app_user@localhost:5433/ecole
# Migrations : rôle propriétaire de la base
DATABASE_ADMIN_URL=postgres://proprio:proprio@localhost:5433/ecole
# Authentification (Better Auth) : secret aléatoire de 32 caractères ou plus,
# différent pour chaque environnement (openssl rand -hex 32). Jamais dans le dépôt.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# En-tête où NOTRE proxy (hébergement) écrit l’IP réelle du client, ex. x-real-ip.
# Vide en local : les en-têtes envoyés par le client ne sont jamais crus.
IP_CLIENT_EN_TETE=
# Accès depuis une autre machine du réseau local (développement) : nom d’hôte ou IP
# du poste (ex. 192.168.1.10), et origine complète pour l’authentification.
ORIGINES_DEV=
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Agendas des intervenants (#73) -----------------------------------------
# Clé de chiffrement des secrets en base (32 octets en base64), à générer une
# fois et à ne jamais perdre : openssl rand -base64 32
CLE_CHIFFREMENT=
# Applications OAuth de l'éditeur (une par fournisseur, pour toutes les écoles).
# Adresse de retour à déclarer : <BETTER_AUTH_URL>/api/agenda/retour/google
# (resp. /microsoft). Laisser vide pour ne pas proposer le fournisseur.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
