# Application : rôle soumis à la Row Level Security
DATABASE_URL=postgres://app_user:app_user@localhost:5433/ecole
# Migrations: a role that owns the tables (or is a superuser) AND bypasses RLS
# (superuser or BYPASSRLS). Otherwise FORCE ROW LEVEL SECURITY hides every row
# from data backfills in migrations; npm run db:migrate refuses to start (#279).
# Never run drizzle-kit migrate directly: always npm run db:migrate.
DATABASE_ADMIN_URL=postgres://proprio:proprio@localhost:5433/ecole
# Authentification (Better Auth) : secret aléatoire de 32 caractères ou plus,
# différent pour chaque environnement (openssl rand -hex 32). Jamais dans le dépôt.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# En-tête où NOTRE proxy (hébergement) écrit l’IP réelle du client, ex. x-real-ip.
# Vide en local : les en-têtes envoyés par le client ne sont jamais crus.
IP_CLIENT_EN_TETE=
# Accès depuis une autre machine du réseau local (développement) : nom d’hôte ou IP
# du poste (ex. 192.168.1.10), et origine complète pour l’authentification.
ORIGINES_DEV=
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Agendas des intervenants (#73) -----------------------------------------
# Clé de chiffrement des secrets en base (32 octets en base64), à générer une
# fois et à ne jamais perdre : openssl rand -base64 32
CLE_CHIFFREMENT=
# Applications OAuth de l'éditeur (une par fournisseur, pour toutes les écoles).
# Adresse de retour à déclarer : <BETTER_AUTH_URL>/api/agenda/retour/google
# (resp. /microsoft). Laisser vide pour ne pas proposer le fournisseur.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Outil de facturation fictif (#303) --------------------------------------
# 1 : autorise l’outil de facturation fictif (numéros « TEST-… », bandeau
# « Mode simulation »). Tests et démonstration locale seulement : refusé quand
# NODE_ENV=production quelle que soit sa valeur (#351) ; NODE_ENV=production
# est la valeur par défaut de « next start » : ne jamais la remplacer en
# production. Toute autre valeur que 1 le refuse.
INVOICING_FAKE_ALLOWED=

# --- Envoi des factures aux outils de facturation (#304) ---------------------
# Secret de la route de balayage POST /api/taches/factures, appelée par le
# planificateur de l’hébergement (en-tête Authorization: Bearer <secret>).
# 32 caractères ou plus (openssl rand -hex 32), différent par environnement.
# Vide : la route refuse tout appel.
JOBS_SECRET=

# --- Envoi d’e-mails (#105, #179, ADR 0009) ---------------------------------
# Service d’envoi de l’application (Brevo, API transactionnelle) : envoie les
# invitations et liens de mot de passe des écoles sans compte d’envoi propre,
# et toujours les e-mails de confirmation d’adresse. Le domaine de l’adresse
# d’expédition doit être validé chez Brevo (SPF, DKIM, DMARC). Clé : jamais
# dans le dépôt. Vide : pas d’envoi, les liens s’affichent pour être transmis
# à la main (sauf compte propre de l’école, Paramètres › E-mails).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# 1 : envoi fictif quand Brevo n’est pas configuré, les messages restent en
# mémoire et ne partent pas. Tests et démonstration seulement : refusé quand
# NODE_ENV=production, quelle que soit cette valeur (#404) : donc avec
# `next dev` et les tests seulement, jamais derrière `next start`, même pour
# une démonstration. Toute autre valeur le refuse.
EMAIL_FAKE_ALLOWED=

# --- Production (#337, docs/guides/deployment.md) ----------------------------
# Rien à remplir en local. En production, chaque processus reçoit seulement ses
# variables (tableau « Environment per process » du guide) ; l’image fixe
# NODE_ENV=production, PORT=3000 et HOSTNAME=0.0.0.0.
# Base gérée : ajouter ?sslmode=verify-full à DATABASE_URL et DATABASE_ADMIN_URL ;
# si le certificat du fournisseur vient de sa propre autorité, chemin du
# certificat de cette autorité monté dans le conteneur (laisser commenté en local) :
# NODE_EXTRA_CA_CERTS=/etc/ecole-saas/ca-base.pem
# Planificateur seulement (deploy/run-task.sh), jamais dans les conteneurs :
# adresse appelée (POST) quand une tâche planifiée échoue, et adresse appelée
# après chaque succès (facultative, détecte un planificateur arrêté).
ALERT_URL=
HEARTBEAT_URL=
