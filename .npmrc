# Ne pas installer automatiquement les dépendances « peer » : better-auth
# déclare des peers optionnels pour d'autres frameworks (SvelteKit → vite 8)
# qui entrent en conflit avec vitest 3 (vite 7). Les peers réellement utilisés
# (next, react, drizzle-orm…) sont déclarés dans package.json.
legacy-peer-deps=true
