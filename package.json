{
  "name": "ecole-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d db",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "calendars:sync": "tsx --env-file=.env scripts/sync-calendars.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "sh scripts/preflight.sh",
    "prepare": "sh scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/dates": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "better-auth": "1.7.7",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "8.3.4"
  }
}
